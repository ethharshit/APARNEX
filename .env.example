NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
# Optional runtime override for same-origin checks; normally use the same URL
APP_ORIGIN=https://your-site.netlify.app
# Supabase transaction pooler URI from Connect. URL-encode password characters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=verify-full
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Existing Supabase Auth users allowed into the staff dashboard
ADMIN_EMAILS=
# Optional email integration; requires a verified sender domain
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=Aparnexpharma@gmail.com
SEND_CUSTOMER_CONFIRMATION=false
